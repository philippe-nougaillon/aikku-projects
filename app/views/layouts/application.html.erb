<!DOCTYPE html>
<html lang="fr" data-theme="corporate">
  <head>
    <title><%= page_title %></title>
    <script>
      (() => {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.css" rel="stylesheet" type="text/css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">

    <%= render partial: "partials/gtag" %>
    <%= render partial: "partials/favicon" %>
  </head>

  <body class="bg-base-100 min-h-screen pb-12">
    <script src="https://cdn.jsdelivr.net/npm/tw-elements/dist/js/tw-elements.umd.min.js"></script>
    <div data-controller="service-worker">
      <%= render partial: "partials/navbar" %>
      <main class="mx-auto px-2 lg:px-12">
        <%= yield %>
        <%= render partial: "partials/notification" %>
      </main>
    </div>
  </body>
</html>
