<div>
  <h1 class="font-bold text-4xl mb-6">
    Stats
  </h1>

  <div class='overflow-x-auto mt-6'>
    <table class='table'>
      <thead>
        <tr>
          <th>Account</th>
          <th>Email</th>
          <th>Dernière Connexion</th>
          <th>Sign_in_count</th>
          <th>Projets</th>
          <th>TodoLists</th>
          <th>Todos</th>
          <th>Lignes</th>
          <th>Modifié le</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <% total_lignes = account_infos(user.account) %>
          <tr>
            <td class="text-neutral"><%= user.account.name %></td>
            <td class="text-neutral"><%= user.email %></td>
            <td class="text-neutral"><%= time_ago_in_words user.last_sign_in_at if user.sign_in_count.positive? %></td>
            <td class=" <%= user.sign_in_count > 10 ? 'text-error font-black' : 'text-black'  %>"><%= user.sign_in_count %></td>
            <% if user.account.users.first == user %>
              <td class=<%= 'text-error' if user.account.projects.count > 1 %>><%= user.account.projects.count %></td>
              <td class=<%= 'text-error' if user.account.todolists.count > 10 %>><%= user.account.todolists.count %></td>
              <td class=<%= 'text-error' if user.account.todos.count > 10 %>><%= user.account.todos.count %></td>
              <td class=<%= 'text-error' if total_lignes > 100 %>><%= total_lignes %></td>
              <td class="text-neutral"><%= time_ago_in_words user.updated_at %></td>
              <td class="text-neutral"><%= link_to "[X]", admin_suppression_compte_path(account: user.account), class:"btn btn-ghost btn-sm" %></td>
            <% else %>
              <td colspan=3>Participant</td>
              <td class="text-neutral"><%= time_ago_in_words user.updated_at %></td>
              <td></td>
            <% end %>
          </tr>
        <% end %>
        <tr></tr>
      </tbody>
    </table>
  </div>

  <span><%= page_entries_info @users, entry_name: 'user' %></span>
  <%= paginate @users %>


</div>
